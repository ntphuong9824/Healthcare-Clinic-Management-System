                <mxCell id="33" value="Nhận từ hệ thống:&lt;br&gt;Báo cáo thống kê tổng hợp, biểu đồ tăng trưởng,&lt;br&gt;báo cáo lợi nhuận, lịch sử hoạt động" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontColor=#333333;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=0;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="10">
